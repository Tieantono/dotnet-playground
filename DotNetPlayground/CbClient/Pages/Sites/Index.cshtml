@page "{siteId}"
@model IndexModel
@{
    ViewData["Title"] = $"Site - {Model.SiteId}";
}

<h2>F737</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                ID
            </th>
            <th>
                Expression
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var row in Model.Rules){
            <tr>
                <td>@row.Id</td>
                <td>@row.Expression</td>
            </tr>
        }
    </tbody>
</table>

